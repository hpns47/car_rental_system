const Invoice = require("../models/Invoice");
const Rental = require("../models/Rental");

exports.createInvoice = async (req, res, next) => {
  try {
    const { rentalId } = req.body;

    const rental = await Rental.findById(rentalId).populate(
      "customerId",
      "name email",
    );

    if (!rental) {
      return res.status(404).json({ error: "Rental not found" });
    }

    const car = await require("../models/Car").findById(rental.carId);

    const itemizedCharges = [
      {
        description: `${rental.totalDays} days rental`,
        amount: rental.basePrice,
        quantity: rental.totalDays,
      },
      {
        description: `${rental.insuranceSelected} insurance`,
        amount: rental.insuranceCost,
        quantity: 1,
      },
    ];

    if (rental.additionalCharges && rental.additionalCharges.length > 0) {
      rental.additionalCharges.forEach((charge) => {
        itemizedCharges.push({
          description: charge.description,
          amount: charge.amount,
          quantity: 1,
        });
      });
    }

    if (rental.damageCharge) {
      itemizedCharges.push({
        description: "Damage charges",
        amount: rental.damageCharge,
        quantity: 1,
      });
    }

    const subtotal = itemizedCharges.reduce(
      (sum, item) => sum + item.amount,
      0,
    );
    const tax = subtotal * 0.1;
    const totalAmount = subtotal + tax;

    const invoiceNumber = `INV-${Date.now()}-${Math.random().toString(36).substr(2, 9).toUpperCase()}`;

    const invoice = new Invoice({
      rentalId,
      customerId: rental.customerId._id,
      invoiceNumber,
      carDetails: {
        make: car.make,
        model: car.model,
        licensePlate: car.licensePlate,
      },
      rentalPeriod: {
        startDate: rental.startDate,
        endDate: rental.endDate,
      },
      itemizedCharges,
      subtotal,
      tax,
      totalAmount,
      remainingBalance: totalAmount,
      dueDate: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000),
      status: "issued",
    });

    await invoice.save();

    res.status(201).json({
      message: "Invoice created successfully",
      invoice,
    });
  } catch (error) {
    next(error);
  }
};

exports.getInvoiceById = async (req, res, next) => {
  try {
    const invoice = await Invoice.findById(req.params.id)
      .populate("customerId", "name email phone")
      .populate("rentalId");

    if (!invoice) {
      return res.status(404).json({ error: "Invoice not found" });
    }

    res.json(invoice);
  } catch (error) {
    next(error);
  }
};

exports.getAllInvoices = async (req, res, next) => {
  try {
    const { status, customerId, page = 1, limit = 10 } = req.query;
    const filter = {};

    if (status) filter.status = status;
    if (customerId) filter.customerId = customerId;

    const skip = (page - 1) * limit;
    const invoices = await Invoice.find(filter)
      .populate("customerId", "name email")
      .limit(Number(limit))
      .skip(skip);

    const total = await Invoice.countDocuments(filter);

    res.json({
      invoices,
      pagination: {
        total,
        page: Number(page),
        limit: Number(limit),
      },
    });
  } catch (error) {
    next(error);
  }
};

exports.markInvoiceAsPaid = async (req, res, next) => {
  try {
    const { amountPaid, paymentMethod } = req.body;

    const invoice = await Invoice.findById(req.params.id);

    if (!invoice) {
      return res.status(404).json({ error: "Invoice not found" });
    }

    invoice.amountPaid = (invoice.amountPaid || 0) + amountPaid;
    invoice.remainingBalance = invoice.totalAmount - invoice.amountPaid;
    invoice.paymentMethod = paymentMethod;

    if (invoice.remainingBalance <= 0) {
      invoice.status = "paid";
      invoice.paymentDate = new Date();
    }

    await invoice.save();

    res.json({
      message: "Payment processed successfully",
      invoice,
    });
  } catch (error) {
    next(error);
  }
};

exports.getCustomerInvoices = async (req, res, next) => {
  try {
    const invoices = await Invoice.find({ customerId: req.user.userId })
      .populate("rentalId")
      .sort({ issueDate: -1 });

    res.json(invoices);
  } catch (error) {
    next(error);
  }
};

exports.getInvoiceReport = async (req, res, next) => {
  try {
    const { startDate, endDate } = req.query;

    const matchStage = {
      issueDate: {
        $gte: new Date(startDate),
        $lte: new Date(endDate),
      },
    };

    const report = await Invoice.aggregate([
      { $match: matchStage },
      {
        $facet: {
          totalRevenue: [
            {
              $group: {
                _id: null,
                total: { $sum: "$totalAmount" },
                count: { $sum: 1 },
              },
            },
          ],
          invoicesByStatus: [
            {
              $group: {
                _id: "$status",
                count: { $sum: 1 },
                amount: { $sum: "$totalAmount" },
              },
            },
          ],
          dailyRevenue: [
            {
              $group: {
                _id: {
                  $dateToString: {
                    format: "%Y-%m-%d",
                    date: "$issueDate",
                  },
                },
                revenue: { $sum: "$totalAmount" },
                invoices: { $sum: 1 },
              },
            },
            { $sort: { _id: 1 } },
          ],
        },
      },
    ]);

    res.json(report[0]);
  } catch (error) {
    next(error);
  }
};
